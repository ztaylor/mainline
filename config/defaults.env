# mainline's defaults. Don't edit this file to configure your account: run `mainline setup`,
# which writes ~/.mainline/config.env (loaded after this file). Any app can override any of
# these in its own app.env.

BUNDLE_PREFIX=""                   # reverse-DNS prefix you control; new apps get BUNDLE_PREFIX.<slug>
DEVELOPMENT_TEAM=""                # 10-character Apple Team ID (needed to ship, not to build or test)

SIMULATOR_NAME="iPhone 17 Pro"     # preferred simulator for build/test/run (falls back to any iPhone)
DEVICE_NAME=""                     # phone for `run --device`: its name or ID (default: the only one connected)

TESTFLIGHT_GROUP="Internal"        # internal TestFlight group that every build is made available to
TESTER_EMAILS=""                   # comma-separated; internal testers must be users of your App Store Connect team

BUILD_WAIT_TIMEOUT=2700            # seconds `ship` waits for App Store Connect to process a build
