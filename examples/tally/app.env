# App metadata: the single source of truth for this app.
# Read by mainline and expanded into project.yml (`${VAR}`) by `mainline gen`.
# Shell syntax: quote values containing spaces.

APP_NAME=Tally                                     # Xcode target and scheme name (a Swift identifier)
DISPLAY_NAME="Tally"                               # the name under the home-screen icon
BUNDLE_ID="${BUNDLE_PREFIX:-com.example}.tally"    # your prefix (from `mainline setup`) + .tally
MARKETING_VERSION=1.0.0                            # user-facing version; build numbers are automatic

# App Store Connect app record (`mainline register` prints these for the web form)
ASC_APP_NAME="Tally"                               # store name: ≤30 characters and unique across the App Store. Choose your own.
SKU=tally                                          # private identifier, never shown to users
PRIMARY_LOCALE=en-US

# App icon (`mainline icon tally` renders Resources/Assets.xcassets/AppIcon.appiconset/AppIcon.png)
ICON_SYMBOL="plus.forwardslash.minus"              # any SF Symbol name, or set ICON_TEXT instead
ICON_TEXT=""
ICON_FROM="#FF8A3D"                                # gradient start (also the accent color)
ICON_TO="#E5383B"                                  # gradient end

# Overrides of your settings in ~/.mainline/config.env, for this app only
# TESTFLIGHT_GROUP="Internal"
# TESTER_EMAILS="a@example.com,b@example.com"
