# App metadata: the single source of truth for this app.
# Read by mainline and expanded into project.yml (`${VAR}`) by `mainline gen`.
# Shell syntax: quote values containing spaces.

APP_NAME=__APP_NAME__                 # Xcode target/scheme name (Swift identifier)
DISPLAY_NAME="__DISPLAY_NAME__"       # name shown under the home-screen icon
BUNDLE_ID=__BUNDLE_ID__               # permanent once the App Store Connect record exists
MARKETING_VERSION=1.0.0               # user-facing version; build numbers are automatic

# App Store Connect app record (`mainline register` prints these for the web form)
ASC_APP_NAME="__DISPLAY_NAME__"       # store name: ≤30 chars, must be unique across the whole App Store
SKU=__SLUG__                          # private identifier, never shown to users
PRIMARY_LOCALE=en-US

# App icon (`mainline icon <app>` re-renders Resources/Assets.xcassets/AppIcon.appiconset/AppIcon.png)
ICON_SYMBOL="__ICON_SYMBOL__"         # any SF Symbol name; or set ICON_TEXT instead
ICON_TEXT=""
ICON_FROM="__ICON_FROM__"             # gradient start (also the accent color)
ICON_TO="__ICON_TO__"                 # gradient end
# ICON_SCRIPT=Branding/render-icon.sh # optional: custom renderer, run as <script> <out.png>, overrides the above

# Overrides of your settings in ~/.mainline/config.env, for this app only
# TESTFLIGHT_GROUP="Internal"
# TESTER_EMAILS="a@example.com,b@example.com"
